<?xml version="1.0" encoding="utf-8"?>
<worldglobal_aio_2>
	<!-- Интенсивность экваториального освещения -->
	<set xpath="//property[@name='ambientEquatorScale']/@value">0.35,0</set>
	<!-- Интенсивность света от поверхностей -->
	<set xpath="//property[@name='ambientGroundScale']/@value">0.15,0</set>
	<!-- Интенсивность света от неба -->
	<set xpath="//property[@name='ambientSkyScale']/@value">0.5,0</set>
	<!-- Интенсивность освещения во время новолуния -->
	<set xpath="//property[@name='ambientMoon']/@value">0,0</set>
	<!-- Скорость изменения освещения при передвижении в помещениях -->
	<set xpath="//property[@name='ambientInsideSpeed']/@value">0.5</set>
	<!-- Порог пропускаемого внутрь помещений освещения -->
	<set xpath="//property[@name='ambientInsideThreshold']/@value">0.1</set>
	<!-- Интенсивность освещения внутри помещений -->
	<set xpath="//property[@name='ambientInsideEquatorScale']/@value">0.1,0.02</set>
	<!-- Интенсивность освещения поверхностей в помещениях -->
	<set xpath="//property[@name='ambientInsideGroundScale']/@value">0.1,0.02</set>
	<!-- Резкость динамического освещения внутри помещений -->
	<set xpath="//property[@name='ambientInsideSkyScale']/@value">0.1,0.01</set>
	<!-- Туман -->
	<set xpath="/worldglobal/environment/property[@name='fogPower']/@value">0.8,0.8</set>
	<!-- <set xpath="/worldglobal/environment/property[@name='ambientMoon']/@value">.9, .3</set> -->
	<!-- <set xpath="/worldglobal/environment/property[@name='ambientSkyScale']/@value">1, .4</set> -->
	<!-- <set xpath="/worldglobal/environment/property[@name='ambientInsideSkyScale']/@value">.9, .4</set> -->
</worldglobal_aio_2>
